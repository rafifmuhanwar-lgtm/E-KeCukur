# ecukur Payment Monitor Configuration
# Salin file ini menjadi payment-monitor/.env dan isi nilainya.

# 1. Token Bot Telegram dari @BotFather (Wajib)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 2. ID Pengguna Telegram Admin (pisahkan koma jika lebih dari satu) (Wajib)
# Dapatkan ID kamu via bot @userinfobot di Telegram
TELEGRAM_ADMIN_IDS=123456789

# 3. ID Grup Telegram untuk notifikasi alert (Opsional)
TELEGRAM_GROUP_ID=-1001234567890

# 4. URL Backend E-CUKUR (default: https://ecukur.biz.id)
BACKEND_API_URL=https://ecukur.biz.id

# 5. Shared Secret API Key untuk autentikasi monitoring (Wajib disamakan di Vercel env BACKEND_API_KEY)
BACKEND_API_KEY=your_secret_api_key_here

# 6. Ambang batas waktu alert pending dalam menit (default: 10)
PAYMENT_PENDING_ALERT_MINUTES=10

